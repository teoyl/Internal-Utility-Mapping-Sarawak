<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="AppCheck_USJ" pageWidth="595" pageHeight="842" columnWidth="451" leftMargin="72" rightMargin="72" topMargin="42" bottomMargin="42" uuid="3867b1a4-3f70-4952-aa51-1874030f35b0">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="135"/>
	<parameter name="pCaseId" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct (uj.usj_job_type||'/'||ltrim(uj.usj_div,0)||'D/'||lpad(uj.usj_seq,4,'0')||'/'||uj.usj_year) as survey_job_number, uj.land_desc, uj.usj_request,
(select code_desc from pubcode where code_type = 'SOC' and code_1 = uj.us_so_id) as surveyFirm,
(select initcap(code_desc) from pubcode where code_type = 'DIV' and code_1 = uj.usj_div) as divName,
uj.related_file_ref, uap.case_ref,
nvl(tcc.CO_REGISTERED_ADDRESS1, '') as cc_addr1, nvl(tcc.CO_REGISTERED_ADDRESS2, '') as cc_addr2, nvl(tcc.CO_REGISTERED_ADDRESS3, '') as cc_addr3,
tcc.CO_REGISTERED_POSTCODE, tcc.CO_REGISTERED_CITY, nvl(tcc.CO_REGISTERED_ADDRESS4, '') as cc_addr4
from us_jobdetail uj
inner join us_application_p uap on uap.case_id = uj.case_id
INNER JOIN US_SURVEY_FIRM_P usfp ON usfp.CASE_ID = uj.CASE_ID
INNER JOIN T_SETUP_USER_P tsup ON tsup.US_USER_ID = uap.APP_SUBMIT_BY
INNER JOIN T_USER_COMPANY tuc ON tuc.US_ID = tsup.US_ID
INNER JOIN T_CUST_COMPANY tcc ON tcc.CO_ID = tuc.CO_ID AND tcc.PS_ID = usfp.FIRM_SOC
where uj.case_id = $P{pCaseId}]]>
	</queryString>
	<field name="SURVEY_JOB_NUMBER" class="java.lang.String"/>
	<field name="LAND_DESC" class="java.lang.String"/>
	<field name="USJ_REQUEST" class="java.lang.String"/>
	<field name="SURVEYFIRM" class="java.lang.String"/>
	<field name="DIVNAME" class="java.lang.String"/>
	<field name="RELATED_FILE_REF" class="java.lang.String"/>
