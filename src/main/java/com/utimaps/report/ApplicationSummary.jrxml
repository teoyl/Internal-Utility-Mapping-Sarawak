	<subDataset name="docDataset" uuid="ee49859f-edf4-4ddc-ab93-53d17008b9f5">
		<parameter name="pCaseId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT uf.FILE_ID, uf.FILE_TYPE, uf.FILE_NAME, uf.FILE_PATH, tsc.CODE_DESC
FROM US_FILE uf
INNER JOIN T_SETUP_CODE tsc ON tsc.CODE_TYPE = 'DOC' AND tsc.CODE_1 = 'APP' AND uf.FILE_TYPE = tsc.CODE_2
and uf.CASE_ID =  $P{pCaseId}
where uf.FILE_STATUS != 'D'
order by tsc.CODE_ID]]>
		</queryString>
		<field name="FILE_ID" class="java.lang.String"/>
		<field name="FILE_TYPE" class="java.lang.String"/>
		<field name="FILE_NAME" class="java.lang.String"/>
		<field name="FILE_PATH" class="java.lang.String"/>
		<field name="CODE_DESC" class="java.lang.String"/>
		<group name="FILE_TYPE">
			<groupExpression><![CDATA[$F{FILE_TYPE}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="pCaseId" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{pCaseId}]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT uap.CASE_ID, uap.PJ_DIV, uap.PJ_NAME, uap.LAND_DIST, uap.LAND_DESC, uap.APP_SUBMIT_DATE,
usfp.FIRM_SOC, usfp.FIRM_OIC, usfp.FIRM_EMAIL, usfp.FIRM_COUNTRY_CODE,
usfp.FIRM_CONTACT_NUM, usfp.FIRM_FAX_COUNTRY_CODE,  usfp.FIRM_FAX_NUM,
(SELECT code_desc FROM pubcode WHERE code_type= 'DIV' AND code_1 = uap.PJ_DIV) AS cc_div,
(SELECT code_desc FROM pubcode WHERE code_type = 'UST' AND CODE_1 = uap.QUAL_LEVEL) AS cc_qual_level,
(SELECT code_desc FROM pubcode WHERE code_type = 'DIS' AND code_1 = uap.PJ_DIV AND code_2 = uap.LAND_DIST) AS cc_dist,
(select code_desc from pubcode where code_type = 'SOC' and code_1 = usfp.FIRM_SOC) as survey_org,
tsup.US_USER_NAME, tsup.US_ID_NUMBER,
(SELECT COUNT(*) FROM US_FILE uf WHERE uf.CASE_ID = uap.CASE_ID AND uf.FILE_TYPE IN (SELECT CODE_2 FROM T_SETUP_CODE tsc WHERE CODE_TYPE= 'DOC' AND CODE_1='APP')) AS doc_count,
(SELECT LISTAGG(p.CODE_DESC, ', ')
  FROM US_APP_LOCALITY_P ualp
  INNER JOIN PUBCODE p ON p.CODE_TYPE = 'ADS' AND p.CODE_1 = uap.PJ_DIV AND code_2=ualp.ADMIN_DIST AND code_acr = 'AD'
  WHERE case_id = uap.CASE_ID AND ualp.ADMIN_DIST IS NOT null) AS cc_admin_dist,
(SELECT LISTAGG(p.CODE_DESC, ', ')
  FROM US_APP_LOCALITY_P ualp2
  INNER JOIN PUBCODE p ON p.CODE_TYPE = 'ADS' AND p.CODE_1 = uap.PJ_DIV AND code_2=ualp2.SUB_DIST AND code_acr = 'SD'
  WHERE case_id = uap.CASE_ID AND ualp2.SUB_DIST IS NOT null) AS cc_sub_dist
FROM US_APPLICATION_P uap
LEFT JOIN US_SURVEY_FIRM_P usfp ON usfp.CASE_ID = uap.CASE_ID
LEFT JOIN T_SETUP_USER_P tsup ON tsup.US_USER_ID = uap.CREATED_BY
where uap.CASE_ID = $P{pCaseId}]]>
	</queryString>
	<field name="CASE_ID" class="java.lang.String"/>
	<field name="PJ_DIV" class="java.lang.String"/>
	<field name="PJ_NAME" class="java.lang.String"/>
	<field name="LAND_DIST" class="java.lang.String"/>
	<field name="LAND_DESC" class="java.lang.String"/>
	<field name="APP_SUBMIT_DATE" class="java.sql.Timestamp"/>
	<field name="FIRM_SOC" class="java.lang.String"/>
	<field name="FIRM_OIC" class="java.lang.String"/>
	<field name="FIRM_EMAIL" class="java.lang.String"/>
	<field name="FIRM_COUNTRY_CODE" class="java.lang.String"/>
	<field name="FIRM_CONTACT_NUM" class="java.lang.String"/>
	<field name="FIRM_FAX_COUNTRY_CODE" class="java.lang.String"/>
	<field name="FIRM_FAX_NUM" class="java.lang.String"/>
	<field name="CC_DIV" class="java.lang.String"/>
	<field name="CC_QUAL_LEVEL" class="java.lang.String"/>
	<field name="CC_DIST" class="java.lang.String"/>
	<field name="SURVEY_ORG" class="java.lang.String"/>
	<field name="US_USER_NAME" class="java.lang.String"/>
	<field name="US_ID_NUMBER" class="java.lang.String"/>
	<field name="DOC_COUNT" class="java.math.BigDecimal"/>
	<field name="CC_ADMIN_DIST" class="java.lang.String"/>
	<field name="CC_SUB_DIST" class="java.lang.String"/>
