	<subDataset name="ChecklistDataset" uuid="f4443fa8-0ef3-4dcd-bd72-f69bb39133d2">
		<parameter name="pCaseId" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{pCaseId}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT to_char(tsci.CI_SEQUENCE, 'fmrn') as CI_SEQUENCE, tsci.CI_DESC, uf.FILE_ID, uf.FILE_NAME, uf.FILE_PATH
FROM T_SETUP_CHECKLIST tsc
INNER JOIN T_SETUP_CHECKLIST_ITEM tsci
ON tsci.CHECKLIST_ID = tsc.CHECKLIST_ID AND tsci.CI_STATUS = 'Y'
LEFT JOIN US_FILE uf
ON uf.CI_ID = tsci.CI_ID AND case_id = $P{pCaseId}
AND file_type IN (SELECT code_2 FROM T_SETUP_CODE tsc WHERE CODE_TYPE = 'DOC' AND CODE_1 = 'APP') and file_status != 'D'
WHERE tsc.PROCESS_TYPE = 'APP01' AND CHECKLIST_STATUS = 'Y'
ORDER BY tsci.CI_SEQUENCE ASC]]>
		</queryString>
		<field name="CI_SEQUENCE" class="java.lang.String"/>
		<field name="CI_DESC" class="java.lang.String"/>
		<field name="FILE_ID" class="java.lang.String"/>
		<field name="FILE_NAME" class="java.lang.String"/>
		<field name="FILE_PATH" class="java.lang.String"/>
		<group name="CI_SEQUENCE">
			<groupExpression><![CDATA[$F{CI_SEQUENCE}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="ChecklistDataset_internal" uuid="cf8da4de-ecfc-42b4-9d84-347022b2ef85">
		<parameter name="pChecklistId" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{pChecklistId}]]></defaultValueExpression>
		</parameter>
		<parameter name="pCaseId" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{pCaseId}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT tsci.CI_DESC, tsci.CI_NOTES, tsci.CI_SEQUENCE, uci2.CL_RESULT, uci2.CL_REMARKS FROM T_SETUP_CHECKLIST tsc
INNER JOIN T_SETUP_CHECKLIST_ITEM tsci
ON tsci.CHECKLIST_ID = tsc.CHECKLIST_ID AND tsci.CI_STATUS = 'Y'
LEFT JOIN US_CHECKLIST_ITEM uci2
ON uci2.CI_ID = tsci.CI_ID AND uci2.CASE_ID = $P{pCaseId}
WHERE tsc.CHECKLIST_ID = $P{pChecklistId}
ORDER BY tsci.CI_SEQUENCE]]>
		</queryString>
		<field name="CI_DESC" class="java.lang.String"/>
		<field name="CI_NOTES" class="java.lang.String"/>
		<field name="CI_SEQUENCE" class="java.math.BigDecimal"/>
		<field name="CL_RESULT" class="java.lang.String"/>
		<field name="CL_REMARKS" class="java.lang.String"/>
		<group name="CI_SEQUENCE">
			<groupExpression><![CDATA[$F{CI_SEQUENCE}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="pCaseId" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{pCaseId}]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT nvl(TO_CHAR(uap.APP_SUBMIT_DATE, 'DD/MM/YYYY'), '-') AS received_date,
nvl(uap.PJ_NAME, '-') as PJ_NAME, nvl(uap.LAND_DESC, '-') as LAND_DESC,
uap.CASE_REF,
(uj.usj_job_type||'/'||ltrim(uj.usj_div,0)||'D/'||ltrim(uj.usj_seq,0)||'/'||uj.usj_year) as USJ_NO,
 nvl((select code_desc from pubcode where code_type = 'SOC' and code_1 = usfp.FIRM_SOC), '-') as company_name,
nvl(TO_CHAR(uj.DATE_ISSUE, 'DD/MM/YYYY'), '-') AS issued_date,
nvl(uc.CHECK_COMMENT_OIC, '-') AS check_comment,
nvl((SELECT us_user_name FROM t_setup_user WHERE us_id=uc.CHECK_BY_OIC), '-') AS check_by,
nvl(TO_CHAR(uc.CHECK_DATE_OIC, 'dd.MM.yyyy'), '-') AS check_date, tsci.CHECKLIST_ID,
(uap.CASE_TYPE ||'/'||uap.CASE_SEQ ||'/'||uap.CASE_YEAR) as cc_uap
 FROM US_APPLICATION_P uap
 INNER JOIN US_SURVEY_FIRM_P usfp
 ON usfp.CASE_ID = uap.CASE_ID
INNER JOIN US_CHECKLIST uc
on uc.case_id = uap.case_id and uc.CHECK_TYPE = 'APP01'
INNER JOIN US_CHECKLIST_ITEM uci
ON uc.CHECK_ID = uci.CHECK_ID
INNER JOIN T_SETUP_CHECKLIST_ITEM tsci
ON uci.CI_ID = tsci.CI_ID
LEFT JOIN US_JOBDETAIL uj
ON uj.CASE_ID = uap.CASE_ID
where uap.CASE_ID = $P{pCaseId}]]>
	</queryString>
	<field name="RECEIVED_DATE" class="java.lang.String"/>
	<field name="PJ_NAME" class="java.lang.String"/>
	<field name="LAND_DESC" class="java.lang.String"/>
	<field name="CASE_REF" class="java.lang.String"/>
	<field name="USJ_NO" class="java.lang.String"/>
	<field name="COMPANY_NAME" class="java.lang.String"/>
	<field name="ISSUED_DATE" class="java.lang.String"/>
	<field name="CHECK_COMMENT" class="java.lang.String"/>
	<field name="CHECK_BY" class="java.lang.String"/>
	<field name="CHECK_DATE" class="java.lang.String"/>
	<field name="CHECKLIST_ID" class="java.lang.String"/>
	<field name="CC_UAP" class="java.lang.String"/>
