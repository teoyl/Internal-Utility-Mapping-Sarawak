	<subDataset name="ChecklistDataset" uuid="f4443fa8-0ef3-4dcd-bd72-f69bb39133d2">
		<parameter name="pChecklistId" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{pChecklistId}]]></defaultValueExpression>
		</parameter>
		<parameter name="pCaseId" class="java.lang.String">
			<defaultValueExpression><![CDATA[$P{pCaseId}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT tsci.CI_DESC, tsci.CI_NOTES, tsci.CI_SEQUENCE, uci2.CL_RESULT, uci2.CL_REMARKS FROM T_SETUP_CHECKLIST tsc
INNER JOIN T_SETUP_CHECKLIST_ITEM tsci
ON tsci.CHECKLIST_ID = tsc.CHECKLIST_ID AND tsci.CI_STATUS = 'Y'
LEFT JOIN US_CHECKLIST_ITEM uci2
ON uci2.CI_ID = tsci.CI_ID AND uci2.CASE_ID = $P{pCaseId}
WHERE tsc.CHECKLIST_ID = $P{pChecklistId}
ORDER BY tsci.CI_SEQUENCE]]>
		</queryString>
		<field name="CI_DESC" class="java.lang.String"/>
		<field name="CI_NOTES" class="java.lang.String"/>
		<field name="CI_SEQUENCE" class="java.math.BigDecimal"/>
		<field name="CL_RESULT" class="java.lang.String"/>
		<field name="CL_REMARKS" class="java.lang.String"/>
		<group name="CI_SEQUENCE">
			<groupExpression><![CDATA[$F{CI_SEQUENCE}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="pCaseId" class="java.lang.String">
		<defaultValueExpression><![CDATA[$P{pCaseId}]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT nvl(uc.CHECK_COMMENT_OIC, '-') AS check_comment,
nvl((SELECT us_user_name FROM t_setup_user WHERE us_id=uc.CHECK_BY_OIC), '-') AS check_by,
nvl(TO_CHAR(uc.CHECK_DATE_OIC, 'dd.MM.yyyy'), '-') AS check_date,
nvl(uc.COMMENT_SS, '-') AS comment_ss,
nvl((SELECT us_user_name FROM t_setup_user WHERE us_id=uc.CHECK_BY_SS), '-') AS check_by_ss,
nvl(TO_CHAR(uc.CHECK_DATE_SS , 'dd.MM.yyyy'), '-') AS check_date_ss,
nvl((SELECT us_user_name FROM t_setup_user WHERE us_id=uc.VERIFY_BY_OIC), '-') AS verify_by,
nvl(TO_CHAR(uc.VERIFY_DATE_OIC , 'dd.MM.yyyy'), '-') AS verify_date,
 tsci.CHECKLIST_ID,
(uj.usj_job_type||'/'||ltrim(uj.usj_div,0)||'D/'||lpad(uj.usj_seq,4,'0')||'/'||uj.usj_year) as survey_job_number, uj.USJ_DESC,
nvl(TO_CHAR(uj.USJ_RECEIVED_DATE , 'dd.MM.yyyy'), '-') AS received_date,
uap.PJ_NAME
FROM US_CHECKLIST uc
INNER JOIN US_CHECKLIST_ITEM uci
ON uc.CHECK_ID = uci.CHECK_ID
INNER JOIN T_SETUP_CHECKLIST_ITEM tsci
ON uci.CI_ID = tsci.CI_ID
INNER JOIN US_JOBDETAIL uj
ON uj.JOB_ID = uc.CASE_ID
INNER JOIN US_APPLICATION_P uap
ON uj.CASE_ID = uap.CASE_ID
WHERE uc.CHECK_TYPE = 'U30' AND uc.CASE_ID = $P{pCaseId}]]>
	</queryString>
	<field name="CHECK_COMMENT" class="java.lang.String"/>
	<field name="CHECK_BY" class="java.lang.String"/>
	<field name="CHECK_DATE" class="java.lang.String"/>
	<field name="COMMENT_SS" class="java.lang.String"/>
	<field name="CHECK_BY_SS" class="java.lang.String"/>
	<field name="CHECK_DATE_SS" class="java.lang.String"/>
	<field name="VERIFY_BY" class="java.lang.String"/>
	<field name="VERIFY_DATE" class="java.lang.String"/>
	<field name="CHECKLIST_ID" class="java.lang.String"/>
	<field name="SURVEY_JOB_NUMBER" class="java.lang.String"/>
	<field name="USJ_DESC" class="java.lang.String"/>
	<field name="RECEIVED_DATE" class="java.lang.String"/>
	<field name="PJ_NAME" class="java.lang.String"/>
