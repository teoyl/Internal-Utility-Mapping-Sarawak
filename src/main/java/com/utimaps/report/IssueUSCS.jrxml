<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DocCheck_IssueSCS10" pageWidth="597" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="485" leftMargin="70" rightMargin="42" topMargin="42" bottomMargin="42" uuid="bb8aeaaf-0e97-4e35-a875-edd0c51aca34">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="pJobId" class="java.lang.String"/>
	<parameter name="pType" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Projects\\internal-utility-mapping-sarawak\\src\\main\\java\\com\\utimaps\\report\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT (uj.usj_job_type||'/'||ltrim(uj.usj_div,0)||'D/'||ltrim(uj.usj_seq,0)||'/'||uj.usj_year) as survey_job_number,
(ltrim(uj.usj_div,0)||'D/'||ltrim(uj.usj_seq,0)||'/'||uj.usj_year) as cc_reference,
uj.land_desc, TO_CHAR(uj.hardcopy_received_date, 'dd.MM.yyyy') as hardcopy_received_date,
('USP-'||uj.usj_div||'-'||uj.plan_no) as cc_plan_no,
uj.usj_year, uj.plan_no,
TO_CHAR(uj.approval_date, 'dd.MM.yyyy') as approval_date, uj.CONTROL_SV_FLAG,
(SELECT INITCAP(code_desc) FROM pubcode WHERE CODE_TYPE= 'DIV' AND code_1 = uap.CASE_DIV) AS cc_div,
(select code_desc from pubcode where code_type = 'SOC' and code_1 = uj.us_so_id) as surveyFirm,
uap.PJ_NAME,
(SELECT CODE_DESC FROM pubcode WHERE CODE_TYPE='LTH' AND code_1 = uap.CASE_DIV AND code_2 = '00') AS cc_head1,
(SELECT CODE_DESC FROM pubcode WHERE CODE_TYPE='LTH' AND code_1 = uap.CASE_DIV AND code_2 = '01') AS cc_head2,
(SELECT CODE_DESC FROM pubcode WHERE CODE_TYPE='LTH' AND code_1 = uap.CASE_DIV AND code_2 = '02') AS cc_addr1,
(SELECT CODE_DESC FROM pubcode WHERE CODE_TYPE='LTH' AND code_1 = uap.CASE_DIV AND code_2 = '03') AS cc_addr2,
(SELECT CODE_DESC FROM pubcode WHERE CODE_TYPE='LTH' AND code_1 = uap.CASE_DIV AND code_2 = '04') AS cc_tel,
TO_CHAR(sysdate+7, 'dd.MM.yyyy') AS cc_expiry,
nvl(tcc.CO_REGISTERED_ADDRESS1, '') as co_addr1, nvl(tcc.CO_REGISTERED_ADDRESS2, ' ') as co_addr2, nvl(tcc.CO_REGISTERED_ADDRESS3, ' ') as co_addr3,
tcc.CO_REGISTERED_POSTCODE, tcc.CO_REGISTERED_CITY, nvl(tcc.CO_REGISTERED_ADDRESS4, ' ') as co_addr4
FROM US_JOBDETAIL uj
INNER JOIN US_APPLICATION_P uap ON uap.CASE_ID = uj.CASE_ID
INNER JOIN US_SURVEY_FIRM_P usfp ON usfp.CASE_ID = uj.CASE_ID
INNER JOIN T_CUST_COMPANY tcc ON tcc.CO_ID = uap.CO_ID AND tcc.PS_ID = usfp.FIRM_SOC
WHERE uj.JOB_ID = $P{pJobId}]]>
	</queryString>
