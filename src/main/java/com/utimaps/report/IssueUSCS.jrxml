				</textElement>
				<textFieldExpression><![CDATA["2.\tThe submitted digital document(s) as listed in "+($F{CONTROL_SV_FLAG}.equals("Y" ) ? "<style isBold='true' pdfFontName='Helvetica-Bold'>Checklist U10 and U20 </style>are not in compliance " : "<style isBold='true' pdfFontName='Helvetica-Bold'>Checklist U20 </style>is not in compliance \n" )+"with our requirements. Please take immediate remedial action and to resubmit on or before <style isBold='true' pdfFontName='Helvetica-Bold'>"+$F{CC_EXPIRY}+"</style>."]]></textFieldExpression>
			</textField>
			<staticText>
