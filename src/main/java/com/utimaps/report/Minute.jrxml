	<detail>
		<band height="199">
			<textField isStretchWithOverflow="true">
				<reportElement x="70" y="70" width="480" height="20" isPrintWhenDetailOverflows="true" uuid="95c473ae-d6dc-4f62-9b04-821e3576a79f"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="12" isBold="true" isUnderline="true"/>
				</textElement>
				<textFieldExpression><![CDATA["<style isBold='true' pdfFontName='Helvetica-Bold'>Notification on Approval of " + $F{SURVEY_JOB_NUMBER}+" Located At " +$F{PJ_NAME}+"</style>"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement positionType="Float" x="70" y="105" width="255" height="20" uuid="2bcbeb67-4082-4423-a1c0-68767a5227b5"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="12"/>
				</textElement>
				<text><![CDATA[Reference is made to the above matter.]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="70" y="140" width="480" height="20" isPrintWhenDetailOverflows="true" uuid="6727fedd-77ef-40d0-9e91-57e7a74dbce6"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="12"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.15"/>
				</textElement>
				<textFieldExpression><![CDATA["2.\tPlease be informed that the Utility Survey Data and Utility Survey Plan <style isBold='true' pdfFontName='Helvetica-Bold'>"+$F{CC_PLAN_NO}+"</style> in connection with the above-mentioned utility survey job has been approved on <style isBold='true' pdfFontName='Helvetica-Bold'>"+$F{APPROVAL_DATE}+"</style>."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement positionType="Float" x="70" y="175" width="480" height="20" isPrintWhenDetailOverflows="true" uuid="bf6ee72a-30e1-48c4-a070-6b4b2c5268c1"/>
				<textElement verticalAlignment="Middle" markup="styled">
					<font fontName="Arial" size="12"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.15"/>
				</textElement>
				<textFieldExpression><![CDATA["3.\tAttached herewith is the approved Utility Survey Plan, for your necessary actions. Thank you."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="70" y="20" width="162" height="20" uuid="aeb1a08a-cf32-4241-9927-e8d47f12775b"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Arial" size="12" isBold="false" isUnderline="false"/>
				</textElement>
				<text><![CDATA[Planning Officer]]></text>
			</staticText>
