	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="pItemId" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT up.BILL_REF_NO, upi.ITEM_AMOUNT AS payment_amount, upi.RVR_CODE, upi.PAYITEM_ID, regexp_replace(upi.ITEM_REF_NO , '/', '') AS item_ref_no,
(select us_user_name||COALESCE(' ('||us_id_number||')', ' ') from T_SETUP_USER_P tsup where US_USER_ID= uap.APP_SUBMIT_BY) as payee,
(up.DIV_CODE) AS div_no,
(SELECT code_desc FROM pubcode WHERE code_type = 'DIV' AND code_1 = up.DIV_CODE) AS div_desc,
uap.CASE_ID, uap.CASE_REF,
case when upi.subcode is null then (select description from rvrcode where trancode = upi.rvr_code)
else (select description from rvcoddtl where trancode = upi.rvr_code and subcode = upi.subcode) end as rvr_code_desc, '-' AS trn_no
FROM US_PAYMENT up
INNER JOIN US_PAYMENT_ITEM upi ON up.PAYMENT_ID = upi.PAYMENT_ID
INNER JOIN US_APPLICATION_P uap ON uap.CASE_ID = up.CASE_ID
where upi.PAYITEM_ID = $P{pItemId}]]>
	</queryString>
