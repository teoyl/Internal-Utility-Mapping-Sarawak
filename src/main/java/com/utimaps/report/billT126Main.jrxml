	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Project\\TOL_LXG\\src\\main\\java\\com\\las\\report\\tol\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT up.BILL_REF_NO, upi.ITEM_AMOUNT, upi.RVR_CODE, upi.PAYITEM_ID,
uap.APP_SUBMIT_BY AS payee, up.DIV_CODE AS div_no,
(SELECT code_desc FROM pubcode WHERE code_type = 'DIV' AND code_1 = up.DIV_CODE) AS div_desc,
uap.CASE_ID, uap.CASE_REF
FROM US_APPLICATION_P uap
INNER JOIN US_PAYMENT up ON up.CASE_ID = uap.CASE_ID
INNER JOIN US_PAYMENT_ITEM upi ON upi.PAYMENT_ID = up.PAYMENT_ID
WHERE uap.CASE_ID = $P{pSubmissionId}]]>
	</queryString>
