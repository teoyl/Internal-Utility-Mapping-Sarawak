	<subDataset name="paymentTab" uuid="69f3b2c1-728d-479f-9c13-fc19ad810cd5">
		<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
		<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.xml"/>
		<parameter name="pCaseId" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select upi.rvr_code,
case when upi.subcode is null then (select description from rvrcode where trancode = upi.rvr_code)
else (select description from rvcoddtl where trancode = upi.rvr_code and subcode = upi.subcode) end as rvr_code_desc,
upi.RVS_RECEIPTNO, upi.RVS_POSTED,
up.pay_ref_no, up.PAYMENT_STATUS_DATE , upi.ITEM_AMOUNT , up.payment_id,
upi.updated_date, up.payment_id
from US_PAYMENT_ITEM upi , US_PAYMENT up
where up.CASE_ID = $P{pCaseId} and
upi.PAYMENT_ID = up.PAYMENT_ID]]>
		</queryString>
		<field name="RVR_CODE" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="RVR_CODE"/>
			<property name="com.jaspersoft.studio.field.label" value="RVR_CODE"/>
		</field>
		<field name="RVR_CODE_DESC" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="RVR_CODE_DESC"/>
			<property name="com.jaspersoft.studio.field.label" value="RVR_CODE_DESC"/>
		</field>
		<field name="RVS_RECEIPTNO" class="java.lang.String"/>
		<field name="RVS_POSTED" class="java.lang.String"/>
		<field name="PAY_REF_NO" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="PAY_REF_NO"/>
			<property name="com.jaspersoft.studio.field.label" value="PAY_REF_NO"/>
		</field>
		<field name="PAYMENT_STATUS_DATE" class="java.sql.Timestamp"/>
		<field name="ITEM_AMOUNT" class="java.math.BigDecimal">
			<property name="com.jaspersoft.studio.field.name" value="ITEM_AMOUNT"/>
			<property name="com.jaspersoft.studio.field.label" value="ITEM_AMOUNT"/>
		</field>
		<field name="PAYMENT_ID" class="java.lang.String">
			<property name="com.jaspersoft.studio.field.name" value="PAYMENT_ID"/>
			<property name="com.jaspersoft.studio.field.label" value="PAYMENT_ID"/>
		</field>
		<field name="UPDATED_DATE" class="java.sql.Timestamp">
			<property name="com.jaspersoft.studio.field.name" value="UPDATED_DATE"/>
			<property name="com.jaspersoft.studio.field.label" value="UPDATED_DATE"/>
		</field>
		<variable name="vTotalPaid" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{ITEM_AMOUNT}]]></variableExpression>
		</variable>
	</subDataset>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="pCaseId" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT uap.CASE_REF, uap.PJ_NAME, up.DIV_CODE,
(select code_desc from pubcode where code_type = 'DIV' and code_1 = up.DIV_CODE) as cc_div,
up.BILL_REF_NO, (SELECT code_desc from pubcode WHERE code_type = 'SOC' AND code_1 = usfp.FIRM_SOC) AS cc_submit_by
FROM US_APPLICATION_P uap
INNER JOIN US_PAYMENT up ON up.CASE_ID = uap.CASE_ID
INNER JOIN US_SURVEY_FIRM_P usfp ON usfp.CASE_ID = uap.CASE_ID
where uap.CASE_ID = $P{pCaseId}]]>
	</queryString>
	<field name="CASE_REF" class="java.lang.String"/>
	<field name="PJ_NAME" class="java.lang.String"/>
	<field name="DIV_CODE" class="java.lang.String"/>
	<field name="CC_DIV" class="java.lang.String"/>
	<field name="BILL_REF_NO" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.name" value="BILL_REF_NO"/>
		<property name="com.jaspersoft.studio.field.label" value="BILL_REF_NO"/>
	</field>
	<field name="CC_SUBMIT_BY" class="java.lang.String"/>
