        <dynamicAction name="Module_dynamic">
            <!-- dynamic Add/Edit Page setup -->
            <property name="dynamicDescription" value="module" />
            <property name="loadDescsUsed" value="true" />
            <property name="addPageLabels" value="module.type, module.code, module.name, parent.module" />
            <property name="editPageLabels" value="asAddPage" />
            <property name="addPageColumns" value="module_type, module_code, module_name, parentModule.module_name as parent_desc|parentModule.module_id as parent_module_id|parentModule.module_code as parent_code" />
            <property name="editPageColumns" value="asAddPage" />
            <property name="addPageRequired" value="module_type;module.type, module_code;module.code, module_name;module.name" />
            <property name="addPageNoDuplicate" value="module_code;module.code, module_name;module.name" />
            <property name="editPageNoDuplicate" value="asAddPage" />
            <property name="editPageRequired" value="asAddPage" />
            <property name="addPageRequiredWhen" value="parent_module_id;parent.module,module_type;module.type;module.type.S;S" />
            <property name="editPageRequiredWhen" value="asAddPage" />
            <property name="recursiveCheck" value="module_type:S, getParentModule, parent_module_id, parent.module" />
            <property name="modelName" value="com.sains.framework.model.Module" />
            <property name="daoName" value="BaseDAO" />
            <property name="localValidateFormJavascript" value="if (form.module_type.value == 'S'){
                      if (form.parent_code.value == ''){
                      errors[errors.length] = formatText(messageRequired, '[setText]parent.module[/setText]');
                      }
                      }"/>
            <property name="pageJavascript" value="
                      function valcheckType(){
                          form = document.getElementById('dynamicFormId');
                            if (form.module_type.value == 'S'){
                          return true;
                          }
                          return false;
                      }
                      function typeChanged(moduleType){
                          var form = moduleType.form;
                          if (moduleType.value == 'M'){
                              form.parent_module_id.value = '';
                              form.parent_code.value = '';
                              document.getElementById('lbparent_desc').innerHTML = '';
                              form.parent_code.readOnly = true;
                          } else {
                              form.parent_code.readOnly = false;
                          }
                      }" />
            <property name="pageLoadedJavascript" value="
                      var mt = document.getElementById('module_type');
                      if (mt.value == 'M'){
                        mt.form.parent_code.readOnly = true;
                      } else {
                        mt.form.parent_code.readOnly = false;
                      }" />
            <property name="module.type_inputType" value="^select;com.sains.framework.base.CommonList;getModuleOptions;option;keyData;valueData;none;onchange=typeChanged(this)^"/>
            <!--<property name="module.code_inputType" value="[^text^ /]" />-->
            <!--<property name="module.name_inputType" value="[^text^ maxlength='100'/]" />-->
            <!--<property name="parent.module_inputType" value="[^hidden^ /][^hidden^ /][^text^ readonly onchange=%22loadDescs('useSetup_Module', 'module_code', this, 'module_id, module_code, module_name, module_name', 'parent_module_id, parent_code, lbparent_desc, parent_desc', '2', '', '', 'module_code,module_name_as_name')%22 /] [script language='javascript']lookup('Search Module', 'Module', 'module_code,module_id,module_name,module_name', 'parent_code,parent_module_id,lbparent_desc,parent_desc', 'useSetup_Module', 'module_code,module_name', '', 'valcheckType()');[/script][label class='label' id='lbparent_desc' for='lbparent_desc'] [set]parent_desc[/set][/label]" />-->
            <property name="parent.module_inputType" value="[^hidden^ /][^hidden^ /][^text^ readonly onchange=%22loadDescs('useSetup_Module', 'module_code', this, 'module_id, module_code, module_name, module_name', 'parent_module_id, parent_code, lbparent_desc, parent_desc', '2')%22 /] [script language='javascript']lookup('Search Module', 'Module', 'module_code,module_id,module_name,module_name', 'parent_code,parent_module_id,lbparent_desc,parent_desc', 'useSetup_Module', 'module_code,module_name', '', 'valcheckType()');[/script][label class='label' id='lbparent_desc' for='lbparent_desc'] [set]parent_desc[/set][/label]" />
