	<subDataset name="divisionDataset" uuid="65ce55b9-e511-476c-8d0c-c42860a0df4b">
		<parameter name="pDivId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pDivId}]]></defaultValueExpression>
		</parameter>
		<parameter name="pSurveyor" class="java.lang.String"/>
		<parameter name="pStatus" class="java.lang.String"/>
		<parameter name="pDateTo" class="java.util.Date"/>
		<parameter name="pKpiReportType" class="java.lang.String"/>
		<parameter name="pUsLoginId" class="java.lang.String"/>
		<parameter name="pOfficer" class="java.lang.String"/>
		<parameter name="pDateFrom" class="java.util.Date"/>
		<parameter name="pCategory" class="java.lang.String"/>
		<parameter name="pProvider" class="java.lang.String"/>
		<parameter name="pFilterDate" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateTo}== null || $P{pDateTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterCategory" class="java.lang.String">
			<defaultValueExpression><![CDATA[( $P{pCategory} == null || $P{pCategory}.equals( "" ) ? "" : "AND uj.control_sv_flag = '"+$P{pCategory}+"'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterSurveyor" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[($P{pSurveyor} == null || $P{pSurveyor}.equals( "" )? "" : "AND LOWER(uj.licensed_surveyor) LIKE lower('%"+$P{pSurveyor}+"%')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterStatus" class="java.lang.String">
			<defaultValueExpression><![CDATA[( $P{pStatus} == null || $P{pStatus}.equals( "" ) ? "" : "AND temp_uj.cur_status in ("+$P{pStatus}+")"  )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT p.CODE_DESC FROM PUBCODE p WHERE CODE_TYPE = 'DIV' and code_1 = $P{pDivId}]]>
		</queryString>
		<field name="CODE_DESC" class="java.lang.String"/>
	</subDataset>
	<subDataset name="reportDataset" uuid="d89cff8f-0d19-4b65-8bd7-2a2f01440172">
		<queryString language="SQL">
			<![CDATA[SELECT temp_uj.*, (SELECT code_desc FROM t_setup_code WHERE code_type ='JWS' AND code_1 = temp_uj.cur_status ) AS cc_status,
nvl((SELECT us_user_name FROM t_setup_user WHERE us_id=uc_compute.CHECK_BY_SS), '-') AS compute_by,
nvl((SELECT us_user_name FROM t_setup_user WHERE us_id=uc_doc.CHECK_BY_OIC), '-') AS doc_check_by_as,
nvl((SELECT us_user_name FROM t_setup_user WHERE us_id=uc_plan.CHECK_BY_OIC), '-') AS plan_check_by_as
FROM (SELECT uj.job_id, uj.USJ_NO, uj.USJ_YEAR, uj.QUAL_LEVEL, to_char(uj.USJ_SUBMISSION_DATE, 'dd/mm/yyyy') as date_received, uj.CONTROL_SV_FLAG, to_char(uj.HARDCOPY_RECEIVED_DATE, 'dd/mm/yyyy') as hardcopy_date, to_char(uj.COMP_APPROVED_DATE, 'dd/mm/yyyy') as comp_approved_date,
(SELECT code_desc FROM PUBCODE WHERE code_type = 'SOC' AND code_1 = uj.US_SO_ID ) AS licensed_surveyor,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '200') AS comp_start_date,
CASE WHEN uj.control_sv_flag = 'Y' THEN
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '130')
ELSE
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '140') END AS doc_start_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '145') AS doc_end_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '280') AS plan_start_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '281') AS plan_end_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '300') AS spatial_start_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '343') AS spatial_end_date,
to_char(uj.approval_date, 'dd/mm/yyyy') AS ss_approved_date，
CASE WHEN uj.wf_status_2 != NULL THEN uj.wf_status_2 ELSE uj.wf_status END AS cur_status
FROM US_JOBDETAIL uj
WHERE uj.job_id IS NOT null and uj.usj_div = '01'
ORDER BY uj.usj_year, uj.usj_seq asc) temp_uj
LEFT JOIN US_CHECKLIST uc_compute
ON uc_compute.case_id = temp_uj.job_id AND uc_compute.CHECK_TYPE = 'U30'
LEFT JOIN US_CHECKLIST uc_doc
ON uc_doc.case_id = temp_uj.job_id AND uc_doc.CHECK_TYPE IN ('U10','U20')
LEFT JOIN US_CHECKLIST uc_plan
ON uc_plan.case_id = temp_uj.job_id AND uc_plan.CHECK_TYPE = 'U50'
WHERE temp_uj.usj_no IS NOT NULL]]>
		</queryString>
		<field name="JOB_ID" class="java.lang.String"/>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="USJ_YEAR" class="java.lang.String"/>
		<field name="QUAL_LEVEL" class="java.lang.String"/>
		<field name="DATE_RECEIVED" class="java.lang.String"/>
		<field name="CONTROL_SV_FLAG" class="java.lang.String"/>
		<field name="HARDCOPY_DATE" class="java.lang.String"/>
		<field name="COMP_APPROVED_DATE" class="java.lang.String"/>
		<field name="LICENSED_SURVEYOR" class="java.lang.String"/>
		<field name="COMP_START_DATE" class="java.lang.String"/>
		<field name="DOC_START_DATE" class="java.lang.String"/>
		<field name="DOC_END_DATE" class="java.lang.String"/>
		<field name="PLAN_START_DATE" class="java.lang.String"/>
		<field name="PLAN_END_DATE" class="java.lang.String"/>
		<field name="SPATIAL_START_DATE" class="java.lang.String"/>
		<field name="SPATIAL_END_DATE" class="java.lang.String"/>
		<field name="SS_APPROVED_DATE" class="java.lang.String"/>
		<field name="CUR_STATUS" class="java.lang.String"/>
		<field name="CC_STATUS" class="java.lang.String"/>
		<field name="COMPUTE_BY" class="java.lang.String"/>
		<field name="DOC_CHECK_BY_AS" class="java.lang.String"/>
		<field name="PLAN_CHECK_BY_AS" class="java.lang.String"/>
	</subDataset>
	<parameter name="pDateFrom" class="java.util.Date"/>
	<parameter name="pDateTo" class="java.util.Date"/>
	<parameter name="pOfficer" class="java.lang.String"/>
	<parameter name="pUsLoginId" class="java.lang.String"/>
	<parameter name="pSurveyor" class="java.lang.String"/>
	<parameter name="pProvider" class="java.lang.String"/>
	<parameter name="pCategory" class="java.lang.String"/>
	<parameter name="pDivId" class="java.lang.String"/>
	<parameter name="pStatus" class="java.lang.String"/>
	<parameter name="pKpiReportType" class="java.lang.String"/>
	<queryString>
		<![CDATA[select count(*) FROM US_JOBDETAIL]]>
	</queryString>
	<field name="COUNT(*)" class="java.math.BigDecimal"/>
