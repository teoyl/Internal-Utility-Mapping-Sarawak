	<subDataset name="jobsBySurveyOrganisationDataset" uuid="a9487d14-3baf-42f9-85d6-56ef153d0af0">
		<parameter name="pQualityLevel" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pCategory" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pProvider" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pSurveyor" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pDateTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pDateFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pFilterDate" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateTo}== null || $P{pDateTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterCategory" class="java.lang.String">
			<defaultValueExpression><![CDATA[( $P{pCategory} == null || $P{pCategory}.equals( "" ) ? "" : "AND uj.control_sv_flag = '"+$P{pCategory}+"'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterQualityLevel" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pQualityLevel} == null || $P{pQualityLevel}.equals( "" ) ? "" : "AND uj.qual_level = '"+$P{pQualityLevel}+"'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterSurveyor" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[($P{pSurveyor} == null || $P{pSurveyor}.equals( "" )? "" : "AND LOWER(uj.licensed_surveyor) LIKE lower('%"+$P{pSurveyor}+"%')" )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT uj.USJ_NO, uj.CONTROL_SV_FLAG, uj.QUAL_LEVEL,
(SELECT code_desc FROM PUBCODE p WHERE code_type = 'SOC' AND code_1 = uj.US_SO_ID) AS surveyOrganisation,
' ' AS utilityProvider, nvl(TO_CHAR(uj.USJ_SUBMISSION_DATE, 'dd/mm/yyyy'), '-') AS dateCompleted,
' ' AS ssName,
CASE WHEN uj.WF_STATUS_2 IS NULL THEN (SELECT code_desc FROM T_SETUP_CODE WHERE code_type = 'JWS' AND code_1 = uj.wf_status)
	ELSE (SELECT code_desc FROM T_SETUP_CODE WHERE code_type = 'JWS' AND code_1 = uj.wf_status_2) END AS ssAction
FROM US_JOBDETAIL uj
WHERE uj.JOB_ID IS NOT NULL
and uj.WF_STATUS_2 IN ('350', '351')
$P!{pFilterCategory}
$P!{pFilterDate}
$P!{pFilterQualityLevel}
$P!{pFilterSurveyor}]]>
		</queryString>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="CONTROL_SV_FLAG" class="java.lang.String"/>
		<field name="QUAL_LEVEL" class="java.lang.String"/>
		<field name="SURVEYORGANISATION" class="java.lang.String"/>
		<field name="UTILITYPROVIDER" class="java.lang.String"/>
		<field name="DATECOMPLETED" class="java.lang.String"/>
		<field name="SSNAME" class="java.lang.String"/>
		<field name="SSACTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="completedJobDataset" uuid="bd556eb4-4a18-4a9a-9a19-b07b16ef70aa">
		<parameter name="pDateFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pDateTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pFilterDate" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateTo}== null || $P{pDateTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT uj.USJ_NO,
TO_CHAR(uph.PROCESS_DATE, 'dd/mm/yyyy') AS date_completed,
(SELECT us_user_name FROM T_SETUP_USER WHERE us_user_id = uph.PROCESS_BY) AS ssName FROM US_JOBDETAIL uj
INNER JOIN US_PROCESSING_HISTORY uph ON uj.JOB_ID = uph.CASE_ID AND uph.PROCESS_CODE = '351'
WHERE uj.WF_STATUS_2 = '351'
$P!{pFilterDate}
ORDER BY uj.USJ_YEAR, uj.USJ_SEQ asc]]>
		</queryString>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="DATE_COMPLETED" class="java.lang.String"/>
		<field name="SSNAME" class="java.lang.String"/>
	</subDataset>
	<subDataset name="kivJobDataset" uuid="53ae0b5c-f51d-4977-95e1-6d9ade122c86">
		<parameter name="pDateFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pDateTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pFilterDate" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateTo}== null || $P{pDateTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<queryString language="SQL">
			<![CDATA[SELECT uj.USJ_NO,
TO_CHAR(uph.PROCESS_DATE, 'dd/mm/yyyy') AS date_completed,
(SELECT us_user_name FROM T_SETUP_USER WHERE us_user_id = uph.PROCESS_BY) AS ssName FROM US_JOBDETAIL uj
INNER JOIN US_PROCESSING_HISTORY uph ON uj.JOB_ID = uph.CASE_ID AND uph.PROCESS_CODE = '301'
WHERE uj.WF_STATUS_2 = '310']]>
		</queryString>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="DATE_COMPLETED" class="java.lang.String"/>
		<field name="SSNAME" class="java.lang.String"/>
	</subDataset>
	<subDataset name="queryJobDataset" uuid="8dd4096e-e9a9-47bf-8fba-a928648f5a09">
		<parameter name="pDateFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pDateTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pFilterDate" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateTo}== null || $P{pDateTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT uj.USJ_NO,
TO_CHAR(uph.PROCESS_DATE, 'dd/mm/yyyy') AS date_queried,
(SELECT us_user_name FROM T_SETUP_USER WHERE us_user_id = uph.PROCESS_BY) AS ssName FROM US_JOBDETAIL uj
INNER JOIN US_PROCESSING_HISTORY uph ON uj.JOB_ID = uph.CASE_ID AND uph.PROCESS_CODE = '301'
WHERE uj.WF_STATUS_2 IN ('136', '146', '164', '202', '205', '222', '282')
$P!{pFilterDate}
ORDER BY uj.USJ_YEAR, uj.USJ_SEQ asc]]>
		</queryString>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="DATE_QUERIED" class="java.lang.String"/>
		<field name="SSNAME" class="java.lang.String"/>
	</subDataset>
	<subDataset name="outstandingJobDataset" whenResourceMissingType="Empty" uuid="ddedd457-565a-4cef-b7f8-0d977af42bbb">
		<parameter name="pOfficer" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pOfficer}]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterOfficer" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pOfficer}.equals( " " )||$P{pOfficer} == null ? "" : "AND ujs.TASK_ASSIGN_TO LIKE '%"+$P{pOfficer}+"%'" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pDateFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pDateTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pFilterDate" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateTo}== null || $P{pDateTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT uj.USJ_NO, uj.JOB_ID ,
TO_CHAR(ujs.STATUS_DATE, 'dd/mm/yyyy') AS date_assigned,
nvl((SELECT us_user_name FROM T_SETUP_USER WHERE us_user_id = ujs.CREATED_BY), ujs.CREATED_BY) AS assign_from,
nvl((SELECT us_user_name FROM T_SETUP_USER WHERE us_user_id = ujs.TASK_ASSIGN_TO), ujs.TASK_ASSIGN_TO) AS assign_to,
(SELECT code_desc FROM T_SETUP_CODE WHERE code_type = 'JWS' AND code_1 = uj.wf_status_2 ) AS cc_action
FROM US_JOBDETAIL uj
INNER JOIN US_JOB_STATUS ujs ON uj.JOB_ID = ujs.CASE_ID AND ujs.CUR_STATUS = 'N'
WHERE uj.WF_STATUS_2 NOT IN ('301', '310', '106', '136', '146', '164', '202', '205', '222', '282')
ORDER BY uj.USJ_YEAR, uj.USJ_SEQ asc]]>
		</queryString>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="JOB_ID" class="java.lang.String"/>
		<field name="DATE_ASSIGNED" class="java.lang.String"/>
		<field name="ASSIGN_FROM" class="java.lang.String"/>
		<field name="ASSIGN_TO" class="java.lang.String"/>
		<field name="CC_ACTION" class="java.lang.String"/>
	</subDataset>
	<subDataset name="officerJobDataset" uuid="74512ef5-5542-4229-a44a-95d7ee1032f5">
		<parameter name="pOfficer" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterOfficer" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pOfficer}==null || $P{pOfficer}.equals( "" ) ? "" : "AND lower(tsu.US_USER_NAME) LIKE LOWER('%"+$P{pOfficer}+"%')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pDateFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pDateTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pFilterDate" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateTo}== null || $P{pDateTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(ujs.STATUS_DATE, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT TO_CHAR(ujs.STATUS_DATE , 'dd/mm/yyyy') AS dateAssigned,
nvl((SELECT us_user_name FROM T_SETUP_USER WHERE us_user_id = ujs.STATUS_BY), ujs.status_by) AS assignedBy,
nvl(tsu.US_USER_NAME, '-') as us_user_name,
nvl(uj.USJ_NO, uap.CASE_REF) AS usj_no,
(SELECT code_desc FROM T_SETUP_CODE WHERE code_type = 'JWS' AND code_1 = ujs.STATUS_CODE) AS cc_action
FROM US_JOB_STATUS ujs
LEFT JOIN US_JOBDETAIL uj ON ujs.CASE_ID = uj.JOB_ID OR ujs.CASE_ID = uj.CASE_ID
LEFT JOIN US_APPLICATION_P uap ON ujs.CASE_ID = uap.CASE_ID
LEFT JOIN T_SETUP_USER tsu ON ujs.TASK_ASSIGN_TO = tsu.US_USER_ID
WHERE ujs.status_date IS NOT NULL
$P!{pFilterOfficer}
$P!{pFilterDate}
ORDER BY uj.usj_no, ujs.STATUS_DATE asc]]>
		</queryString>
		<field name="DATEASSIGNED" class="java.lang.String"/>
		<field name="ASSIGNEDBY" class="java.lang.String"/>
		<field name="US_USER_NAME" class="java.lang.String"/>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="CC_ACTION" class="java.lang.String"/>
	</subDataset>
