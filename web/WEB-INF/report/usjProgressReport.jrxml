	</parameter>
	<parameter name="pFilterCategory" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[( $P{pCategory} == null || $P{pCategory}.equals( "" ) ? "" : "AND uj.control_sv_flag = '"+$P{pCategory}+"'"  )]]></defaultValueExpression>
	</parameter>
	<parameter name="pFilterStatus" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[( $P{pStatus} == null || $P{pStatus}.equals( "" ) ? "" : "AND temp_uj.cur_status in ("+$P{pStatus}+")"  )]]></defaultValueExpression>
	</parameter>
	<parameter name="pFilterUspNo" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[( $P{pUspNo} == null || $P{pUspNo}.equals( "" ) ? "" : "AND temp_uj.plan_no in ='"+$P{pUspNo}+"'"  )]]></defaultValueExpression>
	</parameter>
	<parameter name="pFilterQualityLevel" class="java.lang.String" isForPrompting="false">
