	</parameter>
	<parameter name="pFilterHardcopyReceived" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA[( $P{pHardcopyReceivedTo}== null || $P{pHardcopyReceivedTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.hardcopy_received_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pHardcopyReceivedFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pHardcopyReceivedTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
