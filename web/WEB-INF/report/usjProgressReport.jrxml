	<subDataset name="reportDataset" uuid="33747868-3f03-4be9-8d5c-16c08b2af6bd">
		<parameter name="pUsjYear" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="pSurveyor" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pFilterSurveyor" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[($P{pSurveyor} == null || $P{pSurveyor}.equals( "" )? "" : "AND LOWER(temp_uj.licensed_surveyor) LIKE lower('%"+$P{pSurveyor}+"%')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterUsjYear" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pUsjYear} == null || $P{pUsjYear}.equals( "" ) ? "" : "AND temp_uj.usj_year='"+$P{pUsjYear}+"'" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pDateReceivedFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pDateReceivedTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pHardcopyReceivedFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pHardcopyReceivedTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pStatusDateFrom" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pStatusDateTo" class="java.util.Date" isForPrompting="false"/>
		<parameter name="pProvider" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pUspNo" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pCategory" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pQualityLevel" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pLocality" class="java.lang.String" isForPrompting="false"/>
		<parameter name="pFilterHardcopyReceived" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pHardcopyReceivedTo}== null || $P{pHardcopyReceivedTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.hardcopy_received_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pHardcopyReceivedFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pHardcopyReceivedTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterDateReceived" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateReceivedTo}== null || $P{pDateReceivedTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateReceivedFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateReceivedTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterCategory" class="java.lang.String">
			<defaultValueExpression><![CDATA[( $P{pCategory} == null || $P{pCategory}.equals( "" ) ? "" : "AND uj.control_sv_flag = '"+$P{pCategory}+"'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pDivId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pDivId}]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterStatus" class="java.lang.String">
			<defaultValueExpression><![CDATA[( $P{pStatus} == null || $P{pStatus}.equals( "" ) ? "" : "AND temp_uj.cur_status in ("+$P{pStatus}+")"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pStatus" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pStatus}]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterLocality" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pLocality} == null || $P{pLocality}.equals( "" ) ? "" : "AND lower(temp_uj.land_desc) like '%"+$P{pLocality}+"%'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterQualityLevel" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pQualityLevel} == null || $P{pQualityLevel}.equals( "" ) ? "" : "AND temp_uj.qual_level = '"+$P{pQualityLevel}+"'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterUspNo" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pUspNo} == null || $P{pUspNo}.equals( "" ) ? "" : "AND temp_uj.plan_no in ='"+$P{pUspNo}+"'"  )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT temp_uj.*, (SELECT code_desc FROM t_setup_code WHERE code_type ='JWS' AND code_1 = temp_uj.cur_status ) AS cc_status
FROM (SELECT uj.USJ_NO, uj.USJ_YEAR, uj.QUAL_LEVEL, to_char(uj.USJ_SUBMISSION_DATE, 'dd/mm/yyyy') as date_received, uj.CONTROL_SV_FLAG, to_char(uj.HARDCOPY_RECEIVED_DATE, 'dd/mm/yyyy') as hardcopy_date, to_char(uj.COMP_APPROVED_DATE, 'dd/mm/yyyy') as comp_approved_date,
(SELECT code_desc FROM PUBCODE WHERE code_type = 'SOC' AND code_1 = uj.US_SO_ID ) AS licensed_surveyor,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '200') AS comp_start_date,
CASE WHEN uj.control_sv_flag = 'Y' THEN
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '130')
ELSE
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '140') END AS doc_start_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '145') AS doc_end_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '280') AS plan_start_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '281') AS plan_end_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '300') AS spatial_start_date,
(SELECT to_char(max(process_date), 'dd/mm/yyyy') FROM US_PROCESSING_HISTORY WHERE CASE_id = uj.job_id AND process_code = '341') AS spatial_end_date,
to_char(uj.approval_date, 'dd/mm/yyyy') AS ss_approved_date，
CASE WHEN uj.wf_status_2 != NULL THEN uj.wf_status_2 ELSE uj.wf_status END AS cur_status,
uul.len_ele, uul.len_wat, uul.len_tel, uul.len_sew, uul.len_oil, uul.len_gas, uul.len_unk, uul.len_top
FROM US_JOBDETAIL uj
LEFT JOIN SDE.US_UTILITY_LENGTH uul
ON uul.job_id = uj.job_id
WHERE uj.job_id IS NOT null and uj.usj_div = $P{pDivId}
$P!{pFilterCategory}
$P!{pFilterDateReceived}
$P!{pFilterHardcopyReceived}
$P!{pFilterUspNo}
$P!{pFilterQualityLevel}
$P!{pFilterLocality}
ORDER BY uj.usj_year, uj.usj_seq asc) temp_uj
WHERE temp_uj.usj_no IS NOT NULL
$P!{pFilterUsjYear}
$P!{pFilterSurveyor}
$P!{pFilterStatus}]]>
		</queryString>
		<field name="USJ_NO" class="java.lang.String"/>
		<field name="QUAL_LEVEL" class="java.lang.String"/>
		<field name="DATE_RECEIVED" class="java.lang.String"/>
		<field name="CONTROL_SV_FLAG" class="java.lang.String"/>
		<field name="HARDCOPY_DATE" class="java.lang.String"/>
		<field name="COMP_APPROVED_DATE" class="java.lang.String"/>
		<field name="LICENSED_SURVEYOR" class="java.lang.String"/>
		<field name="COMP_START_DATE" class="java.lang.String"/>
		<field name="DOC_START_DATE" class="java.lang.String"/>
		<field name="DOC_END_DATE" class="java.lang.String"/>
		<field name="PLAN_START_DATE" class="java.lang.String"/>
		<field name="PLAN_END_DATE" class="java.lang.String"/>
		<field name="SS_APPROVED_DATE" class="java.lang.String"/>
		<field name="CC_STATUS" class="java.lang.String"/>
		<field name="SPATIAL_START_DATE" class="java.lang.String"/>
		<field name="SPATIAL_END_DATE" class="java.lang.String"/>
		<field name="LEN_TOP" class="java.math.BigDecimal"/>
		<field name="LEN_UNK" class="java.math.BigDecimal"/>
		<field name="LEN_GAS" class="java.math.BigDecimal"/>
		<field name="LEN_OIL" class="java.math.BigDecimal"/>
		<field name="LEN_SEW" class="java.math.BigDecimal"/>
		<field name="LEN_TEL" class="java.math.BigDecimal"/>
		<field name="LEN_WAT" class="java.math.BigDecimal"/>
		<field name="LEN_ELE" class="java.math.BigDecimal"/>
	</subDataset>
	<subDataset name="divisionDataset" uuid="cb2a67c5-4404-4abc-bd3e-cca8fead60b3">
		<parameter name="pDivId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pDivId}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT p.CODE_DESC FROM PUBCODE p WHERE CODE_TYPE = 'DIV' and code_1 = $P{pDivId}]]>
		</queryString>
		<field name="CODE_DESC" class="java.lang.String"/>
	</subDataset>
