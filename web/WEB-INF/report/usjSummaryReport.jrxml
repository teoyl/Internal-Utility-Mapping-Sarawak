	<subDataset name="reportDataset" uuid="7f8dc796-be80-4537-a485-56d19323f840">
		<parameter name="pDateReceivedFrom" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pDateReceivedFrom}]]></defaultValueExpression>
		</parameter>
		<parameter name="pDateReceivedTo" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pDateReceivedTo}]]></defaultValueExpression>
		</parameter>
		<parameter name="pHardcopyReceivedFrom" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pHardcopyReceivedFrom}]]></defaultValueExpression>
		</parameter>
		<parameter name="pHardcopyReceivedTo" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pHardcopyReceivedTo}]]></defaultValueExpression>
		</parameter>
		<parameter name="pStatusDateFrom" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pStatusDateFrom}]]></defaultValueExpression>
		</parameter>
		<parameter name="pStatusDateTo" class="java.util.Date" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pStatusDateTo}]]></defaultValueExpression>
		</parameter>
		<parameter name="pUsjYear" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pUsjYear}]]></defaultValueExpression>
		</parameter>
		<parameter name="pSurveyor" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pSurveyor}]]></defaultValueExpression>
		</parameter>
		<parameter name="pProvider" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pProvider}]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterDateReceived" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pDateReceivedTo}== null || $P{pDateReceivedTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.usj_submission_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateReceivedFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pDateReceivedTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pDivId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pDivId}]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterHardcopyReceived" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pHardcopyReceivedTo}== null || $P{pHardcopyReceivedTo}.equals( "" ) ? "" : "AND TO_DATE(to_char(uj.hardcopy_received_date, 'dd/MM/yyyy'),'dd/MM/yyyy') BETWEEN TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pHardcopyReceivedFrom})+"', 'dd/MM/yyyy') AND TO_DATE('"+new SimpleDateFormat("dd/MM/yyyy").format($P{pHardcopyReceivedTo})+"', 'dd/MM/yyyy')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pCategory" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pCategory}]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterUsjYear" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[( $P{pUsjYear} == null || $P{pUsjYear}.equals( "" ) ? "" : "AND uj.usj_year = '"+$P{pUsjYear}+"'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterCategory" class="java.lang.String">
			<defaultValueExpression><![CDATA[( $P{pCategory} == null || $P{pCategory}.equals( "" ) ? "" : "AND uj.control_sv_flag = '"+$P{pCategory}+"'"  )]]></defaultValueExpression>
		</parameter>
		<parameter name="pStatus" class="java.lang.String"/>
		<parameter name="pFilterSurveyor" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[($P{pSurveyor} == null || $P{pSurveyor}.equals( "" )? "" : "AND LOWER(uj.licensed_surveyor) LIKE lower('%"+$P{pSurveyor}+"%')" )]]></defaultValueExpression>
		</parameter>
		<parameter name="pFilterStatus" class="java.lang.String">
			<defaultValueExpression><![CDATA[( $P{pStatus} == null || $P{pStatus}.equals( "" ) ? "" : "AND uj.cur_status in ("+$P{pStatus}+")"  )]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT usj_div, (SELECT code_desc FROM pubcode WHERE code_type = 'DIV' AND code_1 = bb.usj_div) AS div_desc,
sum(bb.completed) AS total_completed, sum(bb.query) AS total_query, sum(bb.inProgress) AS total_inProgress FROM (
SELECT aa.usj_div,
CASE WHEN aa.status IN ('350', '351') THEN 1 ELSE 0 END AS completed,
CASE WHEN aa.status IN ('136', '146', '164', '202', '205', '222', '282') THEN 1 ELSE 0 END AS query,
CASE WHEN aa.status NOT IN ('301', '310', '106', '136', '146', '164', '202', '205', '222', '282') THEN 1 ELSE 0 END AS inProgress
FROM (
	SELECT uj.USJ_NO, uj.USJ_DIV,
	CASE WHEN uj.WF_STATUS_2 is NULL THEN uj.wf_status ELSE uj.wf_status_2 END AS status
	FROM US_JOBDETAIL uj
	WHERE uj.job_id IS NOT null
and uj.usj_div = $P{pDivId}
$P!{pFilterDateReceived}
$P!{pFilterHardcopyReceived}
$P!{pFilterUsjYear}
$P!{pFilterCategory}
$P!{pFilterStatus}
$P!{pFilterSurveyor}
) aa
UNION ALL
SELECT code_1 AS usj_div, 0 AS completed, 0 AS query, 0 AS inProgress FROM PUBCODE p WHERE code_type = 'DIV' AND CODE_1 NOT IN ('00', '000', '99', 'MD')) bb
GROUP BY usj_div ORDER BY usj_div]]>
		</queryString>
		<field name="USJ_DIV" class="java.lang.String"/>
		<field name="DIV_DESC" class="java.lang.String"/>
		<field name="TOTAL_COMPLETED" class="java.math.BigDecimal"/>
		<field name="TOTAL_QUERY" class="java.math.BigDecimal"/>
		<field name="TOTAL_INPROGRESS" class="java.math.BigDecimal"/>
		<variable name="totalJob" class="java.math.BigDecimal" resetType="Group" resetGroup="divGroup" calculation="Sum">
			<variableExpression><![CDATA[$F{TOTAL_COMPLETED}.add( $F{TOTAL_QUERY} ).add( $F{TOTAL_INPROGRESS} )]]></variableExpression>
		</variable>
		<variable name="sumReceived" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$V{totalJob}]]></variableExpression>
		</variable>
		<variable name="sumCompleted" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{TOTAL_COMPLETED}]]></variableExpression>
		</variable>
		<variable name="sumInProgress" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{TOTAL_INPROGRESS}]]></variableExpression>
		</variable>
		<variable name="sumQuery" class="java.math.BigDecimal" calculation="Sum">
			<variableExpression><![CDATA[$F{TOTAL_QUERY}]]></variableExpression>
		</variable>
		<group name="divGroup">
			<groupExpression><![CDATA[$F{USJ_DIV}]]></groupExpression>
		</group>
	</subDataset>
	<subDataset name="divisionDataset" uuid="eb8b61aa-0cbc-4bf9-a2ce-a36f55d2fcfb">
		<parameter name="pDivId" class="java.lang.String" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{pDivId}]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT p.CODE_DESC FROM PUBCODE p WHERE CODE_TYPE = 'DIV' and code_1 = $P{pDivId}]]>
		</queryString>
		<field name="CODE_DESC" class="java.lang.String"/>
	</subDataset>
